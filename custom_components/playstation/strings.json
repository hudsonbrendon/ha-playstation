{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "PlayStation",
        "menu_options": {
          "account": "PlayStation Network account",
          "console": "PS5 / PS4 console on this network",
          "portable": "PlayStation Portal (or another Sony device without an API)"
        }
      },
      "portable": {
        "title": "PlayStation Portal",
        "description": "The Portal has no API: Home Assistant tracks whether it is on the network (ping), its latency and when it was last seen. Type its IP address (see your router).",
        "data": {
          "host": "IP address",
          "name": "Name"
        }
      },
      "confirm_portable": {
        "title": "Sony device found",
        "description": "A Sony device at {host} does not answer the console protocol, so it is most likely a PlayStation Portal. Add it to track when it is on?",
        "data": {
          "name": "Name"
        }
      },
      "account": {
        "title": "PSN account",
        "description": "Paste your **NPSSO** (64 characters).\n\n1. Sign in at {signin_url} in this browser.\n2. Open [{url}]({url}).\n3. Copy the value of `npsso` (without quotes).\n\nIf the core PlayStation Network integration is set up, its NPSSO is prefilled.",
        "data": {
          "npsso": "NPSSO"
        }
      },
      "console": {
        "title": "Console",
        "description": "Consoles answering on this network are listed. Turn the console on or put it in rest mode first, or type its IP.",
        "data": {
          "console": "Console found",
          "host": "IP address"
        }
      },
      "confirm": {
        "title": "PlayStation found",
        "description": "Add {name} ({host})?"
      }
    },
    "error": {
      "invalid_auth": "NPSSO rejected (expired or wrong)",
      "cannot_connect": "PSN unreachable",
      "not_found": "No console answered at that address"
    },
    "abort": {
      "already_configured": "Already configured",
      "reauth_successful": "Login renewed",
      "not_playstation": "Not a PlayStation"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Remote Play",
        "menu_options": {
          "pair": "Pair Remote Play (PIN)",
          "credential": "Paste wake credential"
        }
      },
      "pair": {
        "title": "Pair Remote Play",
        "description": "On the console: **Settings → System → Remote Play → Link Device**. Type the 8-digit PIN shown (the console must be on). Pairing unlocks rest mode, every controller button and wake.",
        "data": {
          "pin": "PIN",
          "account_id": "PSN account id",
          "online_id": "Online ID"
        }
      },
      "credential": {
        "title": "Wake credential",
        "data": {
          "credential": "Credential"
        }
      }
    },
    "error": {
      "pair_failed": "Pairing refused: check the PIN (it changes every few minutes) and that the console is on",
      "need_account": "Add the PSN account first or type the account id"
    },
    "abort": {
      "nothing_to_configure": "Nothing to configure for the account"
    }
  },
